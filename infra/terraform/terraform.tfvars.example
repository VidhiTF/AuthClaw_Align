project          = "authclaw"
environment      = "staging"
primary_region   = "us-east-1"
secondary_region = "us-west-2"

# Use "single" for development/staging and "per_az" for both production regions.
# Production activation still requires a reviewed state-backed plan and cost approval.
nat_gateway_mode = "single"

# Optional P0-08 direct runtime AWS allowlists. Keep empty unless the inventory
# approves the service caller and exact resource ARN.
# runtime_s3_bucket_arns = {
#   backend = ["arn:aws:s3:::authclaw-prod-documents"]
#   agent   = ["arn:aws:s3:::authclaw-prod-customer-evidence"]
# }
# runtime_kms_key_arns = {
#   backend = ["arn:aws:kms:us-east-1:123456789012:key/replace-me"]
#   agent   = ["arn:aws:kms:us-east-1:123456789012:key/replace-me"]
# }
# runtime_secrets_manager_secret_arns = {
#   agent = ["arn:aws:secretsmanager:us-east-1:123456789012:secret:authclaw/prod/agent/*"]
# }
# runtime_sts_assume_role_arns = [
#   "arn:aws:iam::210987654321:role/authclaw-prod-customer-access"
# ]

container_images = {
  agent          = "123456789012.dkr.ecr.us-east-1.amazonaws.com/authclaw-prod/agent@sha256:replace-with-64-lowercase-hex-characters"
  backend        = "123456789012.dkr.ecr.us-east-1.amazonaws.com/authclaw-prod/backend@sha256:replace-with-64-lowercase-hex-characters"
  gateway        = "123456789012.dkr.ecr.us-east-1.amazonaws.com/authclaw-prod/gateway@sha256:replace-with-64-lowercase-hex-characters"
  console        = "123456789012.dkr.ecr.us-east-1.amazonaws.com/authclaw-prod/console@sha256:replace-with-64-lowercase-hex-characters"
  audit_consumer = "123456789012.dkr.ecr.us-east-1.amazonaws.com/authclaw-prod/audit-consumer@sha256:replace-with-64-lowercase-hex-characters"
  opa            = "123456789012.dkr.ecr.us-east-1.amazonaws.com/authclaw-prod/opa-bundle@sha256:replace-with-64-lowercase-hex-characters"
  presidio       = "123456789012.dkr.ecr.us-east-1.amazonaws.com/authclaw-prod/presidio@sha256:replace-with-64-lowercase-hex-characters"
}

require_immutable_images = true

# Use "production" only after regional ACM certificates, SMTP, and HTTPS DNS are configured.
authclaw_env = "staging"

# Initial Fargate sizing for task-local OPA/Presidio sidecars. Confirm with staging measurements.
gateway_sidecar_task_cpu    = 2048
gateway_sidecar_task_memory = 4096
backend_sidecar_task_cpu    = 2048
backend_sidecar_task_memory = 4096
agent_sidecar_task_cpu      = 1024
agent_sidecar_task_memory   = 2048

# Keep v1 until migration 039 completes; set v2 in a subsequent deployment.
secret_key_version = "v1"
jwt_key_version     = "v1"
session_key_version = "v1"

# Keep true for an SRS-style warm standby database. Set false only for isolated regional test stacks.
enable_cross_region_db_replica = true

# Optional Route53 failover record.
# hosted_zone_id = "Z1234567890"
# domain_name    = "authclaw.example.com"
# primary_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/..."
# secondary_certificate_arn = "arn:aws:acm:us-west-2:123456789012:certificate/..."

# Optional production email/audit integrations.
# smtp_host = "email-smtp.us-east-1.amazonaws.com"
# smtp_from = "security@example.com"
# kafka_brokers = "b-1.example.kafka.us-east-1.amazonaws.com:9092"
# clickhouse_host = "clickhouse.example.internal"
# enable_audit_consumer = true

worker_processes 1;
pid /tmp/authclaw-tls/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
  access_log off;
  client_body_temp_path /tmp/authclaw-tls/client;
  proxy_temp_path /tmp/authclaw-tls/proxy;
  fastcgi_temp_path /tmp/authclaw-tls/fastcgi;
  uwsgi_temp_path /tmp/authclaw-tls/uwsgi;
  scgi_temp_path /tmp/authclaw-tls/scgi;
  server {
    listen 8443 ssl;
    ssl_certificate /tmp/authclaw-tls/cert.pem;
    ssl_certificate_key /tmp/authclaw-tls/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    client_max_body_size 20m;
    location / {
      proxy_pass http://127.0.0.1:${port};
      proxy_http_version 1.1;
      proxy_set_header Host $http_host;
      proxy_set_header Connection "";
      proxy_buffering off;
      proxy_read_timeout 300s;
    }
  }
}

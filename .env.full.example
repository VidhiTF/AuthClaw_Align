# AuthClaw full local environment.
# Use with: docker compose --env-file .env.full -f docker-compose.full.yml up -d --build

POSTGRES_DB=authclaw
POSTGRES_USER=authclaw
POSTGRES_PASSWORD=authclaw
POSTGRES_APP_USER=authclaw_app
POSTGRES_APP_PASSWORD=authclaw_app
DATABASE_URL=postgresql://authclaw:authclaw@localhost:5432/authclaw
POSTGRES_HOST=localhost

BACKEND_PORT=8000
GATEWAY_PORT=8080
CONSOLE_PORT=3001
AGENT_PORT=8001
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
OPA_TIMEOUT_MS=5000
PRESIDIO_PORT=3000
PRESIDIO_URL=http://localhost:3000
PRESIDIO_HOST=localhost
KAFKA_PORT=9092
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
AUDIT_CONSUMER_METRICS_PORT=9108

CLICKHOUSE_DB=authclaw
CLICKHOUSE_USER=authclaw
CLICKHOUSE_PASSWORD=authclaw
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123

KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_GATEWAY_TRAFFIC=gateway.traffic
KAFKA_TOPIC_AUDIT_EVENTS=audit.events
KAFKA_TOPIC_AGENT_ACTIONS=agent.actions

API_HOST=localhost
API_PORT=8000
API_DEBUG=true
GATEWAY_HOST=localhost
GATEWAY_TIMEOUT_MS=5000
LOG_LEVEL=DEBUG
LOG_FORMAT=json

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3001
PUBLIC_GATEWAY_URL=http://localhost:8080
NEXT_PUBLIC_AUTHCLAW_DEMO_MODE=false
NEXT_PUBLIC_ENABLE_EXPERIMENTAL_SURFACES=false
PRIVACY_NOTICE_VERSION=2026-07-20
FEATURE_AGENT_ENABLED=true
FEATURE_COMPLIANCE_SCORING=true
FEATURE_AUDIT_EXPORT=true
MFA_ENABLED=true
DEMO_OTP_VISIBLE=false
AUTHCLAW_EMAIL_OUTBOX_PATH=/app/.authclaw/email-outbox.jsonl
AUTHCLAW_LITE_DEMO_PASSWORD=AuthClawDemo!234
# Non-production deterministic TOTP fixture for the seeded full-stack admin.
AUTHCLAW_LITE_DEMO_TOTP_SECRET=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP
AUTHCLAW_ENV=local
AUTHCLAW_COOKIE_SECURE=true

# Generic OIDC SSO identity context (tenant-specific database configuration overrides these values).
OIDC_TENANT_CLAIM=tenant_id
OIDC_TENANT_CLAIM_VALUE=immutable-external-tenant-id
AUTHCLAW_OIDC_TENANT_MAPPINGS={}
OIDC_REQUIRE_MFA=true
OIDC_ACCEPTED_AMR=mfa
OIDC_ACCEPTED_ACR=
OIDC_MAX_AUTH_AGE_SECONDS=43200

JWT_SECRET=authclaw-full-local-jwt-secret-change-me
AGENT_JWT_SECRET=authclaw-full-agent-jwt-secret-change-me
AGENT_JWT_SECRET_V1=authclaw-full-agent-jwt-secret-change-me
AGENT_JWT_SECRET_V2=authclaw-full-agent-jwt-secret-v2-change-me
AUTHCLAW_JWT_KEY_VERSION=v1
AGENT_ENCRYPTION_KEY=YXV0aGNsYXctYWdlbnQtbG9jYWwtZmVybmV0LWtleSE=
AGENT_REDACTION_SALT=authclaw-full-agent-redaction-salt-change-me
SESSION_SECRET=authclaw-full-local-session-secret
SESSION_SECRET_V1=authclaw-full-local-session-secret
SESSION_SECRET_V2=authclaw-full-local-session-secret-v2
AUTHCLAW_SESSION_KEY_VERSION=v1
AUTHCLAW_INTERNAL_SERVICE_SECRET=replace-with-a-long-random-internal-service-secret
API_KEY_HASH_SECRET=authclaw-full-local-api-key-hash-secret
ENVELOPE_KEY=YXV0aGNsYXctbG9jYWwtZmVybmV0LWtleS1jaGFuZ2U=
REDACTION_HASH_SALT=replace-with-a-stable-random-redaction-secret
KMS_KEY_ID=full-local-key
AUTHCLAW_SECRET_PROVIDER=env
AUTHCLAW_SECRET_KEY_VERSION=v1
AUTHCLAW_REQUIRE_SERVICE_TLS=false

# Managed KMS simulation/live configuration (requires AWS access when enabled):
# AUTHCLAW_ENVELOPE_PROVIDER=aws_kms
# AUTHCLAW_AWS_KMS_KEY_ID=alias/authclaw-staging
# AUTHCLAW_REQUIRE_REMOTE_KMS=true

AWS_ENABLED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_S3_BUCKET=authclaw-documents
BEDROCK_ENABLED=false
AWS_BEDROCK_ENDPOINT=
BEDROCK_MAX_REQUESTS_PER_DAY=100
BEDROCK_MAX_TOKENS_PER_DAY=50000
BEDROCK_MAX_COST_ESTIMATE_USD=1.00
AWS_SECRETS_MANAGER_ENABLED=false

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=
AZURE_OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
ANTHROPIC_BASE_URL=https://api.anthropic.com
COHERE_BASE_URL=https://api.cohere.ai
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# SMTP delivery. SMTP_USER is "apikey" for SendGrid; keep the real key only in .env.local.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
SMTP_FROM=verified-sender@example.com
SMTP_TLS=true
INTERNAL_LAUNCH_OWNER_EMAIL=launch-owner@example.com

LOGIN_ACCOUNT_ATTEMPTS_PER_15_MINUTES=10
LOGIN_IP_ATTEMPTS_PER_MINUTE=60
GATEWAY_RATE_LIMIT_ENABLED=true
GATEWAY_RATE_LIMIT_PER_MINUTE=120
GATEWAY_RATE_LIMIT_BURST_10S=30
GATEWAY_RATE_LIMIT_DAILY=10000
GATEWAY_MAX_BODY_BYTES=1048576
GATEWAY_MAX_DAILY_SPEND_USD=25
GATEWAY_ESTIMATED_COST_PER_1K_REQUESTS_USD=1
AUDIT_FAIL_CLOSED=false

# Agent tables use an isolated schema in the shared Postgres database.
AGENT_DATABASE_SCHEMA=agent
AGENT_RUNTIME_DB_ROLE=authclaw_agent_runtime
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-2.5-flash-lite
AUTHCLAW_DISABLE_BACKGROUND_MONITOR=true

# AuthClaw full local environment.
# Use with: docker compose --env-file .env.full -f docker-compose.full.yml up -d --build

POSTGRES_DB=authclaw
POSTGRES_USER=authclaw
POSTGRES_PASSWORD=authclaw
POSTGRES_APP_USER=authclaw_app
POSTGRES_APP_PASSWORD=authclaw_app

BACKEND_PORT=8000
GATEWAY_PORT=8080
CONSOLE_PORT=3001
AGENT_PORT=8001
POSTGRES_PORT=5432
REDIS_PORT=6379
OPA_PORT=8181
PRESIDIO_PORT=3000
KAFKA_PORT=9092
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
AUDIT_CONSUMER_METRICS_PORT=9108

CLICKHOUSE_DB=authclaw
CLICKHOUSE_USER=authclaw
CLICKHOUSE_PASSWORD=authclaw

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
PUBLIC_GATEWAY_URL=http://localhost:8080
NEXT_PUBLIC_AUTHCLAW_DEMO_MODE=false
NEXT_PUBLIC_ENABLE_EXPERIMENTAL_SURFACES=false
DEMO_OTP_VISIBLE=false
AUTHCLAW_EMAIL_OUTBOX_PATH=/app/.authclaw/email-outbox.jsonl
AUTHCLAW_LITE_DEMO_PASSWORD=AuthClawDemo!234
AUTHCLAW_ENV=local
AUTHCLAW_COOKIE_SECURE=false

JWT_SECRET=authclaw-full-local-jwt-secret-change-me
SESSION_SECRET=authclaw-full-local-session-secret
AUTHCLAW_INTERNAL_SERVICE_SECRET=replace-with-a-long-random-internal-service-secret
API_KEY_HASH_SECRET=authclaw-full-local-api-key-hash-secret
ENVELOPE_KEY=YXV0aGNsYXctbG9jYWwtZmVybmV0LWtleS1jaGFuZ2U=
KMS_KEY_ID=full-local-key
AUTHCLAW_SECRET_PROVIDER=env
AUTHCLAW_SECRET_KEY_VERSION=v1
AUTHCLAW_REQUIRE_SERVICE_TLS=false

# Managed KMS simulation/live configuration (requires AWS access when enabled):
# AUTHCLAW_ENVELOPE_PROVIDER=aws_kms
# AUTHCLAW_AWS_KMS_KEY_ID=alias/authclaw-staging
# AUTHCLAW_REQUIRE_REMOTE_KMS=true

AWS_ENABLED=false
BEDROCK_ENABLED=false
AWS_SECRETS_MANAGER_ENABLED=false

GEMINI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
ANTHROPIC_BASE_URL=https://api.anthropic.com
COHERE_BASE_URL=https://api.cohere.ai
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

GATEWAY_RATE_LIMIT_ENABLED=true
GATEWAY_RATE_LIMIT_PER_MINUTE=120
GATEWAY_RATE_LIMIT_BURST_10S=30
GATEWAY_RATE_LIMIT_DAILY=10000
GATEWAY_MAX_BODY_BYTES=1048576
GATEWAY_MAX_DAILY_SPEND_USD=25
GATEWAY_ESTIMATED_COST_PER_1K_REQUESTS_USD=1
AUDIT_FAIL_CLOSED=false

# Agent service uses an isolated database until tenant/service authentication is unified.
AGENT_POSTGRES_DB=authclaw_agent
AGENT_POSTGRES_USER=authclaw_agent
AGENT_POSTGRES_PASSWORD=change-me-agent-local
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-2.5-flash-lite
AUTHCLAW_DISABLE_BACKGROUND_MONITOR=true
